{
    "name": "brents-toasts",
    "version": "2.4.6",
    "description": "Lightweight, plug-and-play toast/snackbar system",
    "homepage": "https://brentspine.github.io/brents-toasts/",
    "bugs": {
        "url": "https://github.com/brentspine/brents-toasts/issues"
    },
    "author": {
        "name": "Brentspine",
        "email": "me@brentspine.de",
        "url": "https://brentspine.de"
    },
    "funding": {
        "type": "individual",
        "url": "https://brentspine.de/r/funding"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/brentspine/brents-toasts.git"
    },
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.esm.js",
    "browser": "dist/index.umd.js",
    "types": "dist/index.d.ts",
    "man": "./man/brents-toasts.1",
    "files": [
        "dist",
        "man"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.esm.js",
            "require": "./dist/index.cjs"
        }
    },
    "keywords": [
        "toast",
        "snackbar",
        "notification",
        "ui"
    ],
    "scripts": {
        "build": "rollup -c",
        "dev": "rollup -c --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "license": "Apache-2.0",
    "sideEffects": false,
    "devDependencies": {
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@vitest/coverage-v8": "^4.1.10",
        "jsdom": "^29.1.1",
        "rollup": "^4.60.2",
        "rollup-plugin-dts": "^6.4.1",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    }
}
